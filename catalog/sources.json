{
  "schemaVersion": 1,
  "sources": {
    "pulse": {
      "repository": "petauron/senulun",
      "workflow": ".github/workflows/release.yml",
      "publishJob": "Publish GitHub release",
      "branch": "main",
      "allowPrerelease": true,
      "recovery": {
        "verifyJob": "Verify protected release source",
        "ciWorkflow": ".github/workflows/ci.yml",
        "ciJob": "rust"
      },
      "image": "ghcr.io/petauron/senulun",
      "archivePrefix": "senulun",
      "runtimeBrand": "senulun",
      "imageApp": "pulse",
      "imageName": "pulse",
      "artifactApp": "pulse-agent",
      "artifactName": "pulse-agent",
      "archives": {"amd64": "x86_64", "arm64": "aarch64"}
    }
  }
}
