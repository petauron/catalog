            "en": "Dashboard HTTPS origin",
            "zh-CN": "面板 HTTPS 地址"
          },
          "description": {
            "en": "The exact HTTPS origin used in your browser, such as https://senulun.example.com. No subpath. Configure the matching access entry before signing in. Agents use their separately configured reachable HTTPS URL.",
            "zh-CN": "浏览器实际访问的 HTTPS 地址，例如 https://senulun.example.com，不含子路径。登录前需配置匹配的访问入口。探针使用单独配置的、可访问的 HTTPS 地址。"
          },
          "required": true,
          "secret": false
        },
        {
          "key": "trusted_proxy_ip",
          "type": "string",
          "label": {
            "en": "Trusted reverse proxy IP",
            "zh-CN": "可信反向代理 IP"
          },
          "description": {
            "en": "Optional exact transport peer IP. Enable only when that proxy discards client-supplied X-Real-IP and overwrites it with the verified visitor IP. Empty disables forwarded visitor IPs.",
            "zh-CN": "可选，填写反代连接 Senulun 时的准确来源 IP。仅在反代会丢弃客户端提供的 X-Real-IP 并用已核实的访客 IP 覆写时启用。留空不信任转发的访客 IP。"
          },
          "required": false,
          "secret": false,
          "default": ""
        }
      ],
      "packageRevision": 3,
      "runtime": {
        "kind": "docker",
        "version": 1,
        "storage": [
          {
            "name": "data",
            "persistent": true
          }
        ],
        "docker": {
          "containers": [
            {
              "name": "pulse",
              "image": "pulse",
              "user": "65532:65532",
              "environment": {
                "SENULUN_PUBLIC_URL": {
                  "config": "public_url"
                },
                "SENULUN_TRUSTED_PROXY_IP": {
                  "config": "trusted_proxy_ip"
                }
              },
              "mounts": [
                {
                  "storage": "data",
                  "target": "/var/lib/senulun"
                }
              ],
              "ports": [
                {
                  "service": "dashboard"
                }
              ],
              "health": {
                "service": "dashboard",
